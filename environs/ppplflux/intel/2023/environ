
#!/bin/bash
#
# ============================================================================
# Standalone I2MEX build environment
#
# PPPL Flux - Rocky Linux 9
# Intel oneAPI 2023.2.0 Classic compilers
# OpenMPI 4.1.6
#
# Uses the same compiler/module ecosystem as TRANSP on Flux,
# but builds I2MEX independently of TRANSP.
#
# Usage:
#     source environ
#     make -f Makefile_flux
#
# ============================================================================

# ============================================================================
# Clean module environment
# ============================================================================

module purge

export PATH="/usr/bin:/bin:${PATH}"
hash -r

# ============================================================================
# Standalone I2MEX root
#

export COMPILER=ICC
export COMPILER_VER=2023

export COMPILER_FLAGS="${I2MEX_HOME}/environs/ppplflux/intel/2023/makefile.mk"

# ============================================================================
# Git
# ============================================================================

module load git

# ============================================================================
# Intel oneAPI 2023.2.0
# ============================================================================

module load intel/2023.2.0

export FC=ifort
export F90=ifort
export CC=icc
export CXX=icpc

export FLIBROOT="/opt/hpc/compiler/intel/2023.2.0/compiler/2023.2.0/linux/compiler/lib/intel64_lin"

# ============================================================================
# OpenMPI 4.1.6
# ============================================================================

module load openmpi/4.1.6-intel-2023.2.0-f6nrfjk

export MPIF90=mpif90
export MPICC=mpicc
export MPICXX=mpicxx

export FORTRAN_COMMAND="${MPIF90}"
export CC_COMMAND="${MPICC}"
export CX_COMMAND="${MPICXX}"

export MPI_FC_CMD_EXT="${MPIF90}"

export MPI_CMD="$(command -v mpiexec) --bind-to none"

# ============================================================================
# HDF5
# ============================================================================

module load openmpi-4.1.6/intel-2023.2.0/hdf5/1.14.6-c77my

export L_HDF5="\
-L${HDF5_HOME}/lib \
-lhdf5_fortran \
-lhdf5"

# ============================================================================
# NetCDF
# ============================================================================

module load openmpi-4.1.6/intel-2023.2.0/netcdf-c/4.9.2-qpqoj
module load openmpi-4.1.6/intel-2023.2.0/netcdf-cxx4/4.3.1-k3jqv
module load openmpi-4.1.6/intel-2023.2.0/netcdf-fortran/4.6.1-bfskx

module load libszip/2.1.1-intel-2023.2.0-bo3cg

export L_NETCDF="\
-L${NETCDF_F_HOME}/lib -lnetcdff \
-L${NETCDF_C_HOME}/lib64 -lnetcdf"

# ============================================================================
# BLAS / LAPACK
#
# Use the same Netlib LAPACK module as TRANSP Intel 2023.
# ============================================================================

module load netlib-lapack/3.11.0-intel-2023.2.0-pf3ms

export BLASHOME="${LAPACK_HOME}/lib64"
export LAPACKHOME="${LAPACK_HOME}/lib64"

export L_BLAS="\
-L${BLASHOME} \
-lblas"

export L_LAPACK="\
-L${LAPACKHOME} \
-llapack \
-lblas"

# ============================================================================
# MDSplus
# ============================================================================

module load mdsplus/7.132.0-intel-2023.2.0

export MDSPLUS_DIR="${MDSPLUS_ROOT:-/opt/pppl/software/intel/2023.2.0/mdsplus/7.132.0}"

export L_MDSPLUS="\
-L${MDSPLUS_DIR}/lib \
-lMdsLib"

# ============================================================================
# EZCDF
# ============================================================================

export EZCDF_HOME="/p/pshare/transp/opt/ezcdf/0.4.0/icc/2023"

export L_EZCDF="\
-L${EZCDF_HOME}/lib \
-lezcdf"

# ============================================================================
# PSPLINE
#
# Use the existing Intel 2023 PSPLINE installation.
# ============================================================================

export PSPLINE_HOME="/p/pshare/transp/opt/pspline/2.4.0/icc/2023"

export L_PSPLINE="\
-L${PSPLINE_HOME}/lib \
-lpspline"

# ============================================================================
# UFILES
# ============================================================================

export UFILES_ROOT="/p/pshare/transp/opt/ufiles/1.0.0/intel/2023"

export L_UFILES="\
-L${UFILES_ROOT}/lib \
-luflib_userio \
-luflib \
-lr4smlib_userio \
-lr4smlib \
-lmds_sub \
-lufhdf \
-lmdstransp \
-linterp_sub \
-lextrac_sub \
-ltrgraf \
-lureadsub \
-ltokid \
-lufencod \
-lufport"

# ---------------------------------------------------------------------------
# Additional UFILES library groups
# ---------------------------------------------------------------------------

export L_MDSDUMMY="\
-L${UFILES_ROOT}/lib \
-lmds_dummy \
-lmdstransp \
-lureadsub \
-lufencod \
-lufport"

export L_SGLIB="\
-L${UFILES_ROOT}/lib \
-lsg \
-ljc \
-lufport"

export L_SGDUMMY="\
-L${UFILES_ROOT}/lib \
-lsgdummy"

# ============================================================================
# Plasma State
# ============================================================================

export PLASMA_STATE_ROOT="/p/pshare/transp/opt/plasma_state/3.7.0/intel/2023"

export L_PLASMA_STATE="\
-L${PLASMA_STATE_ROOT}/lib \
-lcstate_lib \
-lplasma_state \
-lps_xplasma2 \
-lplasma_state_kernel \
-lold_xplasma \
-lgeqdsk_mds \
-lxplasma_debug \
-lxplasma2 \
-lnscrunch \
-lps_bloat \
-lps_smlib \
-lps_comput \
-lps_portlib"

# ============================================================================
# Intel Fortran runtime
# ============================================================================

export FTN_MAIN="${FLIBROOT}/for_main.o"

export FTN_TRAILER="\
-L${FLIBROOT} \
-lifport \
-lintlc \
-limf \
-lifcore \
-lirc \
-lsvml \
-lm \
-ldl"

# ============================================================================
# C++ runtime
# ============================================================================

GCC_PATH="$(gcc -print-file-name=libstdc++.a)"
GCC_DIR="$(dirname "${GCC_PATH}")"

export CPP_TRAILER="\
-L${GCC_DIR} \
-lstdc++"

# ============================================================================
# Readline / terminal libraries
# ============================================================================

export LOADER_TRAILER="\
-L${LOCAL}/other \
-lreadline \
-lhistory \
-ltinfo \
-ldl"

# ============================================================================
# Shared-library runtime search path
#
# Local I2MEX libraries take precedence.
# ============================================================================

export LD_LIBRARY_PATH="${LOCAL}/lib\
:${PLASMA_STATE_ROOT}/lib\
:${UFILES_ROOT}/lib\
:${PSPLINE_HOME}/lib\
:${EZCDF_HOME}/lib\
:${MDSPLUS_DIR}/lib\
:${NETCDF_F_HOME}/lib\
:${NETCDF_C_HOME}/lib64\
:${HDF5_HOME}/lib\
:${BLASHOME}\
:${FLIBROOT}\
:${LD_LIBRARY_PATH:-}"

# ============================================================================
# Build options
# ============================================================================

export MAKE_SO=1
export DEBUG=0

# ============================================================================
# Create standalone build directories
# ============================================================================

mkdir -p "${LOCAL}/lib"
mkdir -p "${LOCAL}/mod"
mkdir -p "${LOCAL}/obj"
mkdir -p "${LOCAL}/bin"

# ============================================================================
# Summary
# ============================================================================

echo
echo "======================================================================"
echo " Standalone I2MEX environment - Intel 2023"
echo "======================================================================"
echo
echo "I2MEX_HOME:"
echo "  ${I2MEX_HOME}"
echo
echo "LOCAL:"
echo "  ${LOCAL}"
echo
echo "COMPILER_FLAGS:"
echo "  ${COMPILER_FLAGS}"
echo
echo "Compilers:"
echo "  FC       = ${FC}"
echo "  CC       = ${CC}"
echo "  CXX      = ${CXX}"
echo "  MPIF90   = ${MPIF90}"
echo
echo "Compiler versions:"
ifort --version | head -1
icc --version | head -1
echo
echo "External packages:"
echo "  UFILES_ROOT       = ${UFILES_ROOT}"
echo "  PLASMA_STATE_ROOT = ${PLASMA_STATE_ROOT}"
echo "  PSPLINE_HOME      = ${PSPLINE_HOME}"
echo "  EZCDF_HOME        = ${EZCDF_HOME}"
echo "  MDSPLUS_DIR       = ${MDSPLUS_DIR}"
echo "  NETCDF_F_HOME     = ${NETCDF_F_HOME}"
echo "  NETCDF_C_HOME     = ${NETCDF_C_HOME}"
echo "  LAPACK_HOME       = ${LAPACK_HOME}"
echo
echo "Build options:"
echo "  MAKE_SO = ${MAKE_SO}"
echo "  DEBUG   = ${DEBUG}"
echo
echo "======================================================================"

unset GCC_PATH
unset GCC_DIR
